{
  "http_server": { "address": "127.0.0.1", "port": "8000", "internal_port": "9000" },
  "http_api": { "disabled": false },
  "health": { "enabled": true },
  "prometheus": { "enabled": true },
  "client": {
    "token": { "issuer": "hhwx-chat", "audience": "hhwx-chat" },
    "queue_max_size": 2097152,
    "channel_limit": 3
  },
  "channel": {
    "namespaces": [
      { "name": "chat", "history_size": 256, "history_ttl": "300s", "force_recovery": true },
      { "name": "chat_activity", "presence": true, "force_push_join_leave": true, "history_size": 256, "history_ttl": "300s", "force_recovery": true },
      { "name": "chat_mentions", "history_size": 256, "history_ttl": "300s", "force_recovery": true }
    ]
  },
  "websocket": { "compression": false }
}
