# ============================================================
# HHWX Web environment template
# Copy to .env.local for local development; set the same values in the deployment platform for production.
# ============================================================

# ------------------------------------------------------------
# Public site settings
# These values are exposed to browsers.
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-hhwx-site.example.com
# Preview deployments are usually injected by the platform.
# NEXT_PUBLIC_VERCEL_URL=your-preview-hostname.vercel.app

# ------------------------------------------------------------
# Supabase: browser client
# Required.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Keep postgres_changes during rollout; switch to broadcast after the private
# snapshot/channel canary has passed.
NEXT_PUBLIC_BANDORI_TRACKER_LIVE_SOURCE=postgres_changes

# ------------------------------------------------------------
# Supabase: server-side service client
# Required for server-side reads/writes.
# ------------------------------------------------------------
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Optional. Only set this when the server-side Supabase URL differs from NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=https://your-project.supabase.co

# ------------------------------------------------------------
# Cloudflare Turnstile
# Optional. Leave both empty to disable Turnstile.
# ------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------
# HHWX site asset CDN
# Static site/game assets should be served from your own asset host.
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_ASSET_CDN_BASE_URL=https://your-site-asset-cdn.example.com

# ------------------------------------------------------------
# Bandori asset CDN
# Optional for public asset-heavy pages. This repo defines the URL contract,
# but does not include HHWX production's private ingestion/mirroring service.
# These two values are usually the same.
# ------------------------------------------------------------
NEXT_PUBLIC_BANDORI_ASSET_CDN_BASE_URL=https://your-bandori-asset-cdn.example.com
BANDORI_ASSET_CDN_BASE_URL=https://your-bandori-asset-cdn.example.com

# ------------------------------------------------------------
# Bandori asset object storage
# Server-side APIs that aggregate HHWX-owned CDN resources should
# read object storage directly instead of fetching the public CDN,
# which may apply bot mitigation to server-to-CDN traffic.
# Keep these values server-side only; never prefix them with NEXT_PUBLIC_.
# ------------------------------------------------------------
# Shared R2/S3 endpoint and read credentials. Readers that use a different
# bucket still declare that bucket explicitly in their own section.
# BANDORI_R2_ACCOUNT_ID=your_cloudflare_account_id
# Or set BANDORI_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
# BANDORI_R2_ACCESS_KEY_ID=your_r2_access_key_id
# BANDORI_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# BANDORI_R2_REGION=auto

# BANDORI_STAMP_CATALOG_OBJECT_KEY=bandori/stamps/index.json
# BANDORI_STAMP_R2_ACCOUNT_ID=your_cloudflare_account_id
# Or set BANDORI_STAMP_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
# BANDORI_STAMP_R2_BUCKET=your_r2_bucket
# BANDORI_STAMP_R2_ACCESS_KEY_ID=your_r2_access_key_id
# BANDORI_STAMP_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# BANDORI_STAMP_R2_REGION=auto
# For shared private deployments, these may also be supplied as
# BANDORI_ASSET_R2_* or BANDORI_R2_*. BANDORI_MASTER_R2_* is accepted only
# when it points at the same bucket that contains Bandori asset objects.

# ------------------------------------------------------------
# Bandori Events v3 private snapshot
# Required by /api/bandori/master/events and its detail route. The reader only
# accepts bandori/event-history-v3/api/active.json and never falls back to v2.
# Reuse BANDORI_R2_* or BANDORI_MASTER_R2_* endpoint and credentials above.
# ------------------------------------------------------------
# BANDORI_PRIVATE_R2_BUCKET=hhwx-private
# Local development only; production rejects this setting.
# BANDORI_EVENT_API_LOCAL_STORE_ROOT=/path/to/event-history-v3/store

# ------------------------------------------------------------
# Bandori cutoff-history API
# Keep "supabase" during deployment, then switch to
# "r2-with-supabase-fallback" after the read-only comparison passes.
# "r2" disables request-time Supabase fallback.
# Reuse the server-only BANDORI_R2_* endpoint and credentials.
# ------------------------------------------------------------
BANDORI_TRACKER_HISTORY_SOURCE=supabase
# BANDORI_TRACKER_HISTORY_R2_BUCKET=your_public_artifact_bucket
# Local development only; production rejects this setting.
# BANDORI_TRACKER_HISTORY_LOCAL_STORE_ROOT=/path/to/cutoff-history/store

# ------------------------------------------------------------
# Bandori chart source
# Defaults to Bestdori for web-only self-hosted deployments.
# Set BANDORI_CHART_SOURCE=assets after your asset builder publishes
# /bandori/music/{musicId}/charts/{difficulty}.json.
# ------------------------------------------------------------
BANDORI_CHART_SOURCE=bestdori
# BANDORI_MUSIC_CDN_BASE_URL=https://your-bandori-asset-cdn.example.com
# BANDORI_CHART_BESTDORI_FALLBACK=0
BANDORI_SONG_NOTES_SOURCE=bestdori
# BANDORI_SONG_NOTES_SOURCE=assets
# Keep this enabled during asset index rollout; strict assets mode returns 503
# when the index cannot be read or has incomplete note coverage.
# BANDORI_SONG_NOTES_BESTDORI_FALLBACK=0

# ------------------------------------------------------------
# Bandori master artifacts
# Server-side only. hhwx-tracker publishes these JSON artifacts.
# Artifact mode serves most public master datasets from HHWX artifacts.
# Events use the private Events v3 snapshot configured above. songs.notes
# defaults to Bestdori and can switch to the HHWX music asset index after
# chart-derived note counts are fully published.
# ------------------------------------------------------------
BANDORI_MASTER_SOURCE=bestdori
# Comma-separated server order for artifact mode. Payloads are merged into one
# Bestdori-style response with regional arrays, not exposed as per-server URLs.
# Use BANDORI_MASTER_ARTIFACT_SERVER as the single-server fallback.
# BANDORI_MASTER_ARTIFACT_SERVERS=jp,cn
BANDORI_MASTER_ARTIFACT_SERVER=cn
# Object-storage active manifest entry. Example:
# BANDORI_MASTER_ARTIFACT_BASE_URL=https://cdn.hhwx.org/bandori/master
# Supabase active pointer mode also needs a public origin for manifest/artifact paths.
# BANDORI_MASTER_ACTIVE_SOURCE=object-storage
# BANDORI_MASTER_ARTIFACT_PUBLIC_ORIGIN=https://cdn.hhwx.org
# BANDORI_MASTER_ARTIFACT_MANIFEST_URL=https://cdn.hhwx.org/bandori/master/{server}/active/manifest.json
#
# Production can bypass the public CDN and read master artifacts from R2 directly.
# Keep these values server-side only; never prefix them with NEXT_PUBLIC_.
# BANDORI_MASTER_ARTIFACT_READ_MODE=r2
# BANDORI_MASTER_ARTIFACT_PREFIX=bandori/master
# BANDORI_MASTER_R2_ACCOUNT_ID=your_cloudflare_account_id
# Or set BANDORI_MASTER_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
# BANDORI_MASTER_R2_BUCKET=your_r2_bucket
# BANDORI_MASTER_R2_ACCESS_KEY_ID=your_r2_access_key_id
# BANDORI_MASTER_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# BANDORI_MASTER_R2_REGION=auto
# For shared private deployments, these may also be supplied as BANDORI_R2_*.

# ------------------------------------------------------------
# HHWX user fetcher service for game-account binding verification and manual game data sync.
# Private compatible service. This repo does not include an implementation.
# Leave empty unless you operate your own compatible endpoint.
# Server-side only. Do not prefix with NEXT_PUBLIC_.
# ------------------------------------------------------------
HHWX_USER_FETCHER_BASE_URL=
HHWX_USER_FETCHER_TOKEN=
