# ============================================================
# HHWX Web environment template
#
# Copy this file to .env.local for local development. Configure the
# corresponding values in the production runtime. Never commit .env.local.
# ============================================================

# ------------------------------------------------------------
# Public site
# Exposed to browsers. NEXT_PUBLIC_SITE_URL is the canonical origin used
# for authentication callbacks and must be set in every deployment.
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-hhwx-site.example.com

# Optional site/game asset CDN override. HHWX production has a built-in
# default; self-hosted deployments should point this at their own asset host.
# NEXT_PUBLIC_SITE_ASSET_CDN_BASE_URL=https://your-site-asset-cdn.example.com

# ------------------------------------------------------------
# Supabase
# Browser variables are public. SUPABASE_SECRET_KEY is server-only.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Optional server-side URL override. When omitted, server code reuses
# NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=https://your-project.supabase.co

# Bandori tracker live updates use authenticated Private Broadcast channels.
# The live transport is a fixed application contract and has no source switch.

# ------------------------------------------------------------
# Cloudflare Turnstile
# Optional. Leave both values empty to disable Turnstile. Configure or clear
# the browser site key and server secret together.
# ------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------
# Bandori browser asset CDN
# Required for asset-heavy pages. The private ingestion/mirroring service
# used by HHWX production is not included in this repository.
# ------------------------------------------------------------
NEXT_PUBLIC_BANDORI_ASSET_CDN_BASE_URL=https://your-bandori-asset-cdn.example.com

# ------------------------------------------------------------
# Bandori R2/S3 object storage
# Server-only and required by Bandori master, chart, cutoff-history, and
# TOP10 APIs. Supply the complete endpoint; the app does not derive it from
# an account ID. Public and private data use the same endpoint and credentials.
# ------------------------------------------------------------
BANDORI_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
BANDORI_R2_ACCESS_KEY_ID=your_r2_access_key_id
BANDORI_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Public bucket: browser asset indexes, charts, four-server master artifacts,
# and cutoff-history artifacts.
BANDORI_PUBLIC_R2_BUCKET=cdn

# Private bucket: Events, Cards, Music, and Stamps snapshots plus TOP10 history.
BANDORI_PRIVATE_R2_BUCKET=hhwx-private

# ------------------------------------------------------------
# Local Bandori object-store overrides
# Development and integration tests only. Production rejects these settings.
# ------------------------------------------------------------
# BANDORI_CARDS_API_LOCAL_STORE_ROOT=/path/to/cards-v1/store
# BANDORI_EVENT_API_LOCAL_STORE_ROOT=/path/to/event-history-v3/store
# BANDORI_MUSIC_API_LOCAL_STORE_ROOT=/path/to/music/store
# BANDORI_STAMPS_API_LOCAL_STORE_ROOT=/path/to/stamps/store
# BANDORI_TOPDATA_HISTORY_LOCAL_STORE_ROOT=/path/to/topdata-history/store
# BANDORI_TRACKER_HISTORY_LOCAL_STORE_ROOT=/path/to/cutoff-history/store

# Chart JSON and JP/EN/TW/CN master artifacts always use signed R2 reads.
# Their sources, region set, and object roots are fixed application contracts.

# ------------------------------------------------------------
# HHWX user fetcher
# Optional private service for game-account binding verification, player
# profiles, and manual game-data sync. The implementation is not in this repo.
# Configure or clear the URL and token together. Server-only.
# ------------------------------------------------------------
HHWX_USER_FETCHER_BASE_URL=
HHWX_USER_FETCHER_TOKEN=
