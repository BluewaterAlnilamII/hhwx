# ============================================================
# HHWX Web environment template
# Copy to .env.local for local development; set the same values in the deployment platform for production.
# ============================================================

# ------------------------------------------------------------
# Public site settings
# These values are exposed to browsers.
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-hhwx-site.example.com
# Preview deployments are usually injected by the platform.
# NEXT_PUBLIC_VERCEL_URL=your-preview-hostname.vercel.app

# ------------------------------------------------------------
# Supabase: browser client
# Required.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Production default after the atomic latest/Broadcast cutover. Use
# postgres_changes only while the legacy history writer is still active.
NEXT_PUBLIC_BANDORI_TRACKER_LIVE_SOURCE=broadcast

# ------------------------------------------------------------
# Supabase: server-side service client
# Required for server-side reads/writes.
# ------------------------------------------------------------
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Optional. Only set this when the server-side Supabase URL differs from NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=https://your-project.supabase.co

# ------------------------------------------------------------
# Cloudflare Turnstile
# Optional. Leave both empty to disable Turnstile.
# ------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------
# HHWX site asset CDN
# Static site/game assets should be served from your own asset host.
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_ASSET_CDN_BASE_URL=https://your-site-asset-cdn.example.com

# ------------------------------------------------------------
# Bandori asset CDN
# Optional for public asset-heavy pages. This repo defines the URL contract,
# but does not include HHWX production's private ingestion/mirroring service.
# ------------------------------------------------------------
NEXT_PUBLIC_BANDORI_ASSET_CDN_BASE_URL=https://your-bandori-asset-cdn.example.com

# ------------------------------------------------------------
# Bandori asset object storage
# Server-side APIs that aggregate HHWX-owned CDN resources should
# read object storage directly instead of fetching the public CDN,
# which may apply bot mitigation to server-to-CDN traffic.
# Keep these values server-side only; never prefix them with NEXT_PUBLIC_.
# ------------------------------------------------------------
# Canonical shared R2/S3 connection settings and read credentials.
# BANDORI_R2_ACCOUNT_ID=your_cloudflare_account_id
# BANDORI_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
# BANDORI_R2_ACCESS_KEY_ID=your_r2_access_key_id
# BANDORI_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Public bucket containing Bandori assets, master artifacts, and cutoff history.
BANDORI_PUBLIC_R2_BUCKET=cdn

# ------------------------------------------------------------
# Bandori Events, Cards, Music, and Stamps private snapshots
# Required by their /api/bandori/master/* routes. Readers only accept their
# dataset-specific active pointer and never fall back to public asset indexes,
# Bestdori, or public master artifacts.
# Reuse the canonical BANDORI_R2_* endpoint and credentials above.
# ------------------------------------------------------------
BANDORI_PRIVATE_R2_BUCKET=hhwx-private
# Local development only; production rejects this setting.
# BANDORI_EVENT_API_LOCAL_STORE_ROOT=/path/to/event-history-v3/store
# BANDORI_CARDS_API_LOCAL_STORE_ROOT=/path/to/cards-v1/store
# BANDORI_MUSIC_API_LOCAL_STORE_ROOT=/path/to/music/store
# BANDORI_STAMPS_API_LOCAL_STORE_ROOT=/path/to/stamps/store

# ------------------------------------------------------------
# Bandori cutoff-history API
# Production reads validated cutoff and TOP10 artifacts from private R2 only.
# Frozen Supabase history is not a runtime source or fallback.
# Reuse the server-only BANDORI_R2_* endpoint and credentials.
# ------------------------------------------------------------
# Local development only; production rejects this setting.
# BANDORI_TRACKER_HISTORY_LOCAL_STORE_ROOT=/path/to/cutoff-history/store
# BANDORI_TOPDATA_HISTORY_LOCAL_STORE_ROOT=/path/to/topdata-history/store

# Chart JSON and JP/EN/TW/CN master artifacts always use signed R2 reads from
# BANDORI_PUBLIC_R2_BUCKET. Their source, region set, and object roots are fixed
# application contracts rather than deployment configuration.

# ------------------------------------------------------------
# HHWX user fetcher service for game-account binding verification and manual game data sync.
# Private compatible service. This repo does not include an implementation.
# Leave empty unless you operate your own compatible endpoint.
# Server-side only. Do not prefix with NEXT_PUBLIC_.
# ------------------------------------------------------------
HHWX_USER_FETCHER_BASE_URL=
HHWX_USER_FETCHER_TOKEN=
